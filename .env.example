DATABASE_URL=postgresql://user:password@host/database
LORA_API_KEY=replace-with-a-long-random-secret
DISCORD_WEBHOOK_URL=
BACKEND_URL=https://example.invalid/update
LORA_COM_PORT=COM6
LORA_BAUD_RATE=115200
